<div class="container py-4">
  <h1 class="mb-4">Shopping Cart</h1>

  <% if @products.any? %>
    <% @products.each do |product| %>
      <div class="card mb-3 shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">

          <!-- Product Info -->
          <div>
            <h5><%= product.name %></h5>
            <p class="mb-1"><strong>Price:</strong> $<%= product.price %></p>
          </div>

          <!-- Controls -->
          <div class="d-flex align-items-center gap-2">

            <!-- Quantity -->
            <%= form_with url: update_cart_path(product), method: :patch, local: true do %>
              <%= number_field_tag :quantity,
                  session[:cart][product.id.to_s],
                  min: 1,
                  class: "form-control",
                  style: "width: 80px;" %>

              <%= submit_tag "Update", class: "btn btn-sm btn-outline-secondary mt-1" %>
            <% end %>

            <!-- Remove -->
            <%= button_to "Remove",
                remove_from_cart_path(product),
                method: :delete,
                class: "btn btn-danger btn-sm" %>

          </div>

        </div>
      </div>
    <% end %>

    <% total = @products.sum { |product| product.price * session[:cart][product.id.to_s] } %>

    <div class="mt-4 text-end">
      <h4>Total: $<%= total.round(2) %></h4>
    </div>

  <% else %>
    <p>Your cart is empty.</p>
  <% end %>

  <%= link_to "Back to Products", products_path, class: "btn btn-secondary mt-3" %>
</div>