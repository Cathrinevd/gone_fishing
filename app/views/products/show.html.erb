<h1><%= @product.name %></h1>

<% if @product.image.attached? %>
  <%= image_tag @product.image, width: 300 %>
<% end %>
<p><%= @product.description %></p>
<p>Brand: <%= @product.brand %></p>
<p>Price: $<%= @product.price %></p>
<p>Stock: <%= @product.stock %></p>

<%= link_to "Back to Products", root_path %>