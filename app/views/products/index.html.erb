<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Gone Fishing</h1>
    <%= link_to "Add New Product", new_product_path, class: "btn btn-secondary" %>
  </div>

  <div class="row g-4 mb-5">
    <div class="col-md-4 col-lg-3">
      <div class="card h-100 shadow-sm">
        <div class="card-header fw-semibold">
          Categories
        </div>
        <div class="list-group list-group-flush">
          <% Category.all.each do |category| %>
            <%= link_to category.name, category_path(category), class: "list-group-item list-group-item-action" %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-8 col-lg-9">
      <div class="card mb-3 shadow-sm">
        <div class="card-header fw-semibold">
          Filter Products
        </div>
        <div class="card-body d-flex flex-wrap gap-2">
          <%= link_to "All", products_path, class: "btn btn-outline-secondary btn-sm" %>
          <%= link_to "New (last 3 days)", products_path(filter: "new"), class: "btn btn-outline-secondary btn-sm" %>
          <%= link_to "Recently Updated", products_path(filter: "recently_updated"), class: "btn btn-outline-secondary btn-sm" %>
        </div>
      </div>

      <div class="card shadow-sm">
        <div class="card-header fw-semibold">
          Search Products
        </div>
        <div class="card-body">
          <%= form_with url: products_path, method: :get, local: true do %>
            <div class="row g-3 align-items-end">
              <div class="col-md-5">
                <%= label_tag :query, "Keyword", class: "form-label" %>
                <%= text_field_tag :query, params[:query], class: "form-control" %>
              </div>

              <div class="col-md-4">
                <%= label_tag :category_id, "Category", class: "form-label" %>
                <%= select_tag :category_id,
                    options_from_collection_for_select(Category.all, :id, :name, params[:category_id]),
                    include_blank: "All Categories",
                    class: "form-select" %>
              </div>

              <div class="col-md-3">
                <%= submit_tag "Search", class: "btn btn-dark w-100" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <h2 class="mb-4">All Products</h2>

  <div class="row">
    <% @products.each do |product| %>
      <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
          <% if product.image.attached? %>
            <%= image_tag product.image, class: "card-img-top", style: "height: 220px; object-fit: cover;" %>
          <% end %>

          <div class="card-body d-flex flex-column">
            <h5 class="card-title">
              <%= link_to product.name, product_path(product), class: "text-decoration-none" %>
            </h5>

            <p class="card-text"><%= truncate(product.description, length: 100) %></p>
            <p class="mb-1"><strong>Brand:</strong> <%= product.brand %></p>
            <p class="mb-1"><strong>Price:</strong> $<%= product.price %></p>
            <p class="mb-1"><strong>Created:</strong> <%= product.created_at.strftime("%Y-%m-%d %H:%M") %></p>
            <p class="mb-3"><strong>Updated:</strong> <%= product.updated_at.strftime("%Y-%m-%d %H:%M") %></p>

            <div class="mt-auto">
              <%= link_to "View Product", product_path(product), class: "btn btn-outline-primary btn-sm" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-4">
    <%= paginate @products %>
  </div>
</div>