<h1>Gone Fishing</h1>

<%= link_to "Add New Product", new_product_path %>

<hr>

<h2>Categories</h2>

<% Category.all.each do |category| %>
  <p><%= link_to category.name, category_path(category) %></p>
<% end %>

<hr>

<h2>Filter Products</h2>

<%= link_to "All", products_path %> |
<%= link_to "New (last 3 days)", products_path(filter: "new") %> |
<%= link_to "Recently Updated", products_path(filter: "recently_updated") %>

<hr>

<h2>Search Products</h2>

<%= form_with url: products_path, method: :get, local: true do %>
  <div>
    <%= label_tag :query, "Keyword" %>
    <%= text_field_tag :query, params[:query] %>
  </div>

  <div>
    <%= label_tag :category_id, "Category" %>
    <%= select_tag :category_id,
        options_from_collection_for_select(Category.all, :id, :name, params[:category_id]),
        include_blank: "All Categories" %>
  </div>

  <div>
    <%= submit_tag "Search" %>
  </div>
<% end %>

<hr>

<h2>All Products</h2>

<% @products.each do |product| %>
  <div>

    <% if product.image.attached? %>
      <%= image_tag product.image, width: 150 %>
    <% end %>

    <h3><%= link_to product.name, product_path(product) %></h3>

    <p><%= product.description %></p>
    <p>Brand: <%= product.brand %></p>
    <p>Price: $<%= product.price %></p>
    <p>Created: <%= product.created_at.strftime("%Y-%m-%d %H:%M") %></p>
    <p>Updated: <%= product.updated_at.strftime("%Y-%m-%d %H:%M") %></p>

  </div>
  <hr>
<% end %>

<%= paginate @products %>