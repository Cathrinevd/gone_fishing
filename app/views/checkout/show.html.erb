<div class="container py-4">
  <h1 class="mb-4">Checkout</h1>

  <% if @products.any? %>

    <% @products.each do |product| %>
      <div class="card mb-3 shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <h5><%= product.name %></h5>
            <p class="mb-1"><strong>Price:</strong> $<%= product.price %></p>
            <p class="mb-1"><strong>Quantity:</strong> <%= session[:cart][product.id.to_s] %></p>
          </div>

          <div>
            <% item_total = product.price * session[:cart][product.id.to_s] %>
            <p class="mb-0"><strong>Subtotal:</strong> $<%= item_total.round(2) %></p>
          </div>
        </div>
      </div>
    <% end %>

    <%= form_with url: checkout_path, method: :get, local: true do %>
      <div class="mb-3">
        <%= label_tag :province_id, "Province", class: "form-label" %>


<%= select_tag :province_id,
    options_from_collection_for_select(@provinces, :id, :name, params[:province_id]),
    class: "form-select",
    onchange: "this.form.submit();" %>

      </div>
    <% end %>

    <div class="text-end mt-4">
      <h5>Subtotal: $<%= @subtotal.round(2) %></h5>
      <h5>Tax: $<%= @tax.round(2) %></h5>
      <h4 class="fw-bold">Total: $<%= @total.round(2) %></h4>
    </div>

    <%= form_with url: place_order_path, method: :post, local: true do %>
      <%= hidden_field_tag :province_id, params[:province_id] %>

      <div class="row g-3 mt-3">
        <div class="col-md-6">
          <%= label_tag :first_name, "First Name", class: "form-label" %>
          <%= text_field_tag :first_name, params[:first_name], class: "form-control" %>
        </div>

        <div class="col-md-6">
          <%= label_tag :last_name, "Last Name", class: "form-label" %>
          <%= text_field_tag :last_name, params[:last_name], class: "form-control" %>
        </div>

        <div class="col-md-6">
          <%= label_tag :email, "Email", class: "form-label" %>
          <%= email_field_tag :email, params[:email], class: "form-control" %>
        </div>

        <div class="col-md-6">
          <%= label_tag :street, "Street", class: "form-label" %>
          <%= text_field_tag :street, params[:street], class: "form-control" %>
        </div>

        <div class="col-md-6">
          <%= label_tag :city, "City", class: "form-label" %>
          <%= text_field_tag :city, params[:city], class: "form-control" %>
        </div>

        <div class="col-md-6">
          <%= label_tag :postal_code, "Postal Code", class: "form-label" %>
          <%= text_field_tag :postal_code, params[:postal_code], class: "form-control" %>
        </div>

        <div class="col-md-6">
          <%= label_tag :country, "Country", class: "form-label" %>
          <%= text_field_tag :country, "Canada", class: "form-control" %>
        </div>
      </div>

      <div class="mt-4 d-flex gap-2">
        <%= link_to "Back to Cart", cart_path, class: "btn btn-secondary" %>
        <%= submit_tag "Place Order", class: "btn btn-success" %>
      </div>
    <% end %>

  <% else %>
    <p>Your cart is empty.</p>
    <%= link_to "Back to Products", products_path, class: "btn btn-secondary" %>
  <% end %>
</div>