<div class="container py-4">
  <h1 class="mb-4">Checkout</h1>

  <% if @products.any? %>

    <% @products.each do |product| %>
      <div class="card mb-3 shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">

          <div>
            <h5><%= product.name %></h5>
            <p class="mb-1"><strong>Price:</strong> $<%= product.price %></p>
            <p class="mb-1">
              <strong>Quantity:</strong>
              <%= session[:cart][product.id.to_s] %>
            </p>
          </div>

          <div>
            <% item_total = product.price * session[:cart][product.id.to_s] %>
            <p class="mb-0">
              <strong>Subtotal:</strong> $<%= item_total.round(2) %>
            </p>
          </div>

        </div>
      </div>
    <% end %>

    <!-- TOTALS -->
    <div class="text-end mt-4">
      <h5>Subtotal: $<%= @subtotal.round(2) %></h5>
      <h5>Tax: $<%= @tax.round(2) %></h5>
      <h4 class="fw-bold">Total: $<%= @total.round(2) %></h4>
    </div>

    <!-- PROVINCE + UPDATE TOTAL -->
    <%= form_with url: checkout_path, method: :get, local: true do %>
      <div class="mb-3">
        <%= label_tag :province, "Province", class: "form-label" %>
        <%= select_tag :province,
            options_for_select(["MB", "ON", "AB"], params[:province]),
            class: "form-select" %>
      </div>

      <div class="mt-3 d-flex gap-2">
        <%= link_to "Back to Cart", cart_path, class: "btn btn-secondary" %>
        <%= submit_tag "Update Total", class: "btn btn-outline-primary" %>
      </div>
    <% end %>

    <!-- PLACE ORDER -->
    <%= button_to "Place Order",
        place_order_path(province: @province),
        method: :post,
        class: "btn btn-success mt-3" %>

  <% else %>
    <p>Your cart is empty.</p>
    <%= link_to "Back to Products", products_path, class: "btn btn-secondary" %>
  <% end %>
</div>