<h1><%= @category.name %></h1>

<% @products.each do |product| %>
  <div>
    <% if product.image.attached? %>
      <%= image_tag product.image, width: 150 %>
    <% end %>
    <h3><%= link_to product.name, product_path(product) %></h3>
    <p><%= product.description %></p>
    <p>$<%= product.price %></p>
  </div>
  <hr>
<% end %>

<%= link_to "Back to Products", root_path %>